# Database connection (required)
DATABASE_URL=postgresql://checkpoint:checkpoint@localhost:5432/checkpoint_dev

# Server port (default: 3000)
PORT=3000

# Allowed CORS origin (default: http://localhost:5173)
# In production, set to your frontend domain
# Multiple origins: comma-separated (e.g. https://app.example.com,https://staging.example.com)
CORS_ORIGIN=http://localhost:5173

# Environment (default: development)
NODE_ENV=development
